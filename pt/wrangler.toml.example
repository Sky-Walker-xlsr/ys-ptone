name = "ptone-pt"
compatibility_date = "2025-04-01"
compatibility_flags = ["nodejs_compat"]
main = ".open-next/worker.js"

[assets]
directory = ".open-next/assets"
binding = "ASSETS"

[vars]
NEXT_PUBLIC_SUPABASE_URL        = "https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY   = "YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY       = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
NEXT_PUBLIC_EXERCISE_SUPABASE_URL      = "https://YOUR_EXERCISE_PROJECT.supabase.co"
NEXT_PUBLIC_EXERCISE_SUPABASE_ANON_KEY = "YOUR_EXERCISE_ANON_KEY"
MS_TENANT_ID      = "YOUR_MS_TENANT_ID"
MS_CLIENT_ID      = "YOUR_MS_CLIENT_ID"
MS_CLIENT_SECRET  = "YOUR_MS_CLIENT_SECRET"
GOOGLE_CALENDAR_CLIENT_ID     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET = "YOUR_GOOGLE_CLIENT_SECRET"
RESEND_API_KEY    = "re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL = "invoices@yourdomain.com"
NEXT_PUBLIC_APP_URL = "https://pt.yourdomain.ch"

[[routes]]
pattern = "pt.yourdomain.ch/*"
zone_name = "yourdomain.ch"
